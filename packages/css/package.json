    "./radio": "./dist/components/radio.css",
    "./dialog": "./dist/components/dialog.css",
    "./divider": "./dist/components/divider.css",
    "./badge": "./dist/components/badge.css",
    "./fab": "./dist/components/fab.css",
    "./icon-button": "./dist/components/icon-button.css",
    "./chips": "./dist/components/chips.css",
    "./progress-indicator": "./dist/components/progress-indicator.css",
    "./slider": "./dist/components/slider.css",
